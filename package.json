{
  "name": "jameskills-governance",
  "private": true,
  "description": "Repository governance tooling for JameSkills (commitlint + hooks only; the product is Rust)",
  "scripts": {
    "prepare": "husky",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "test:commitlint": "bash scripts/test-commitlint.sh",
    "verify:change": "bash scripts/verify_change_gate.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7"
  }
}
